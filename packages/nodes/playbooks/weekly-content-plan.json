{
  "id": "weekly-content-plan",
  "name": "Weekly content plan",
  "summary": "Every Monday: collect the week's signals (competitor changes, news, Reddit and Hacker News), rank the top 5 opportunities, and draft an outline plus a LinkedIn post for each. The plan and every post wait for approval; approved posts go out one per day.",
  "trigger": "schedule",
  "schedule": "weekly mon 09:00",
  "publishesTo": ["Google Docs (the content plan)", "LinkedIn (your profile, one post a day)"],
  "inputs": [
    { "key": "approver", "label": "Who approves the plan and posts", "required": true, "example": "Rahul" },
    { "key": "market_query", "label": "What your market talks about", "required": true, "example": "status page incident communication", "help": "Search terms for news, Reddit and Hacker News." }
  ],
  "defaultInput": { "approver": "", "market_query": "" },
  "nodes": [
    { "key": "start", "type": "trigger.schedule", "name": "Every Monday 09:00", "config": { "cron": "weekly mon 09:00" } },
    { "key": "watch", "type": "intel.watchCompetitors", "name": "Competitor changes", "dependsOn": ["start"], "config": {} },
    { "key": "news", "type": "gdelt.searchDocs", "name": "This week's news", "dependsOn": ["start"],
      "config": { "query": "{{input.market_query}}", "timespan": "7d" } },
    { "key": "reddit", "type": "reddit.search", "name": "Reddit threads", "dependsOn": ["start"],
      "config": { "query": "{{input.market_query}}", "sort": "top", "limit": "10" } },
    { "key": "hn", "type": "hackernews.search", "name": "Hacker News", "dependsOn": ["start"],
      "config": { "query": "{{input.market_query}}", "tags": "story" } },
    { "key": "record_news", "type": "intel.recordSignal", "name": "Record news signals", "dependsOn": ["news"],
      "config": { "source": "news", "items": "outputs.news.articles", "titleField": "title", "urlField": "url" } },
    { "key": "record_reddit", "type": "intel.recordSignal", "name": "Record Reddit signals", "dependsOn": ["reddit"],
      "config": { "source": "reddit", "items": "outputs.reddit.posts", "titleField": "data.title", "urlField": "data.permalink" } },
    { "key": "record_hn", "type": "intel.recordSignal", "name": "Record Hacker News signals", "dependsOn": ["hn"],
      "config": { "source": "hackernews", "items": "outputs.hn.hits", "titleField": "title" } },
    { "key": "rank", "type": "agent.llm", "name": "Rank the top 5 opportunities", "dependsOn": ["watch", "news", "reddit", "hn", "record_news", "record_reddit", "record_hn"],
      "config": { "brand": "true", "responseFormat": "json",
        "system": "You are our content strategist. Pick topics our audience cares about this week where we have something credible to say.",
        "prompt": "This week's signals.\n\nCompetitor changes:\n{{outputs.watch.text}}\n\nNews:\n{{outputs.news.articles}}\n\nReddit:\n{{outputs.reddit.posts}}\n\nHacker News:\n{{outputs.hn.hits}}\n\nRank the 5 best content opportunities. Return JSON:\n{\"opportunities\": [{\"title\": \"...\", \"why\": \"one sentence: the signal and why it matters\", \"outline\": \"5-bullet outline of a blog post\", \"post\": \"a LinkedIn post under 120 words\", \"delayHours\": 24}]}\nUse delayHours 24, 48, 72, 96, 120 for the five items in order (one post a day)." } },
    { "key": "plan_doc_text", "type": "agent.llm", "name": "Write the plan up", "dependsOn": ["rank"],
      "config": { "brand": "false", "system": "You format documents clearly.",
        "prompt": "Turn this content plan into a readable document: for each opportunity, its title, why it matters, and the outline. Plain text with headings.\n\n{{outputs.rank.text}}" } },
    { "key": "approve_plan", "type": "human.approval", "name": "Approve the content plan", "dependsOn": ["plan_doc_text"],
      "config": { "draft": "{{outputs.plan_doc_text.text}}", "title": "This week's content plan", "channel": "Content plan (Google Docs)", "assignee": "{{input.approver}}" } },
    { "key": "plan_doc", "type": "pieces.google-docs.create_document", "name": "Save the content plan", "dependsOn": ["approve_plan"],
      "config": { "title": "Content plan (approved)", "body": "{{outputs.approve_plan.content}}" } },
    { "key": "each_post", "type": "logic.loop", "name": "For each post", "dependsOn": ["rank"],
      "config": { "items": "outputs.rank.data.opportunities" } },
    { "key": "approve_post", "type": "human.approval", "name": "Approve the post", "dependsOn": ["each_post"],
      "config": { "draft": "{{item.post}}", "title": "LinkedIn post: {{item.title}}", "channel": "LinkedIn", "assignee": "{{input.approver}}" } },
    { "key": "post_slot", "type": "logic.wait", "name": "Wait for its day", "dependsOn": ["approve_post"],
      "config": { "hours": "{{item.delayHours}}", "from": "run_start" } },
    { "key": "publish_post", "type": "pieces.linkedin.create_share_update", "name": "Post on LinkedIn", "dependsOn": ["post_slot", "approve_post"],
      "config": { "text": "{{outputs.approve_post.content}}", "visibility": "PUBLIC" } }
  ]
}
