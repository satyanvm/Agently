# ── Supabase ───────────────────────────────────────────────────────────────
# Found in Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row Level Security — used by server routes.
# NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection (for running SQL migrations).
DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# ── LLM providers ────────────────────────────────────────────────────────────
# Provide at least one. The worker uses Anthropic if ANTHROPIC_API_KEY is set,
# otherwise OpenAI if OPENAI_API_KEY is set, otherwise a deterministic mock.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# ── Go API (apps/api) ─────────────────────────────────────────────────────────
# Listen address for the Go backend.
API_ADDR=:8080
# Where the Next.js dev server proxies /api/* (apps/web/next.config.ts).
API_PROXY_TARGET=http://localhost:8080
# Public URL of the web app — used to deep-link runs and to bounce the OAuth
# callback back into the UI.
APP_BASE_URL=http://localhost:3000

# ── Scheduler (apps/api) ──────────────────────────────────────────────────────
# Timezone that "daily HH:MM" schedules are interpreted in (IANA name).
SCHEDULER_TZ=America/Los_Angeles
# Set SCHEDULER=0 to disable the in-process scheduler (e.g. multi-instance API).

# ── Email delivery (apps/worker) ──────────────────────────────────────────────
# A finished run emails its digest. The worker picks ONE email backend per run,
# in this precedence: Gmail-OAuth (if the workspace connected Google) → Resend →
# SMTP. Configure whichever you want; recipient comes from the prompt (run.input.email).
#
# Option 3 — Resend (send FROM the app's own verified domain). Recommended.
RESEND_API_KEY=
EMAIL_FROM=Agently <digests@yourdomain.com>
#
# Option 2 — Google OAuth2 (send AS a connected Gmail account). Create an OAuth
# client at console.cloud.google.com (type "Web application"), enable the Gmail
# API, add the redirect URI below, and request the gmail.send scope.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=http://localhost:8080/api/integrations/google/callback
#
# Fallback — raw SMTP (e.g. Gmail with a 16-char App Password, NOT your password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Default recipient when a run carries no input.email.
NOTIFICATION_EMAIL_TO=
# Optional: also POST the run result to a webhook.
NOTIFICATION_WEBHOOK_URL=
