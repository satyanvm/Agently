# ── Supabase ───────────────────────────────────────────────────────────────
# Found in Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row Level Security — used by the worker and server routes.
# NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection (for running SQL migrations).
DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# ── LLM providers (used by the default llm-loop runner, Phase 4) ─────────────
# Provide at least one. The runner picks a provider based on the agent's model.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Worker ──────────────────────────────────────────────────────────────────
# How often (ms) the worker polls Postgres for queued runs.
WORKER_POLL_INTERVAL_MS=2000
# Max runs a single worker processes concurrently.
WORKER_CONCURRENCY=1
